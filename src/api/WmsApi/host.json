{
    "version": "2.0",
    "telemetryMode": "OpenTelemetry",
    "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Microsoft": "Warning",
      "Worker": "Information"
    }
  }
}
